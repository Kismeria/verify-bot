# discord developer portal -> your app
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# public url of the web server (must match redirect in portal: BASE_URL/callback)
BASE_URL=http://localhost:3000
PORT=3000

# random long string, signs state + salts ip hashes
SESSION_SECRET=change-me

# set to 1 if behind nginx/cloudflare so real ip is read from x-forwarded-for
TRUST_PROXY=0
